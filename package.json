{
  "name": "rad.io",
  "version": "0.0.1",
  "description": "Professional browser-based SDR visualizer with industry-standard signal analysis and universal device support",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prod": "npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser-gate": "node scripts/browser-regression-gate.mjs",
    "test:fps-gate": "node scripts/render-fps-gate.mjs",
    "test:fps-gate:quick": "node scripts/render-fps-gate.mjs --duration-sec 15",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --grep @real-device",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"package.json\" \".github/workflows/*.{yml,yaml}\" \".github/ISSUE_TEMPLATE/*.{yml,yaml}\" \".vscode/tasks.json\" \"README.md\"",
    "format:check": "prettier --check \"package.json\" \".github/workflows/*.{yml,yaml}\" \".github/ISSUE_TEMPLATE/*.{yml,yaml}\" \".vscode/tasks.json\" \"README.md\"",
    "clean": "node -e \"const fs=require('node:fs'); ['dist','coverage'].forEach((dir)=>{ if (fs.existsSync(dir)) fs.rmSync(dir, { recursive: true, force: true }); });\"",
    "validate": "npm run lint && npm run format:check && npm run type-check && npm run test"
  },
  "author": "Alex Mitchell <alex@alexmitchelltech.com>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "usb": "^2.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "prettier": "^3.8.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^1.3.1"
  }
}
