{
  "name": "rad.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm:dev": "wasm-pack build crates/dsp-wasm --target web --dev --out-dir pkg",
    "wasm:release": "wasm-pack build crates/dsp-wasm --target web --release --out-dir pkg",
    "predev": "npm run wasm:dev",
    "dev": "vite",
    "build": "npm run wasm:release && tsc -b && vite build",
    "type-check": "tsc -b",
    "rust:check": "cargo check --workspace",
    "rust:test": "cargo test --workspace",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "validate": "npm run rust:test && npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
