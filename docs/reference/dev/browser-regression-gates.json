{
  "policyId": "phase-1-browser-regression-gates",
  "policyVersion": "1.0.0",
  "effectiveDate": "2026-02-24",
  "owner": "foundation-tooling-observability",
  "defaultBehavior": "fail-closed",
  "description": "Allowed browser/channel combinations for WebUSB and WebAudio regression gate checks.",
  "allowedMatrix": [
    {
      "browser": "chrome",
      "channel": "stable",
      "required": true,
      "notes": "Primary Chromium stable baseline"
    },
    {
      "browser": "edge",
      "channel": "stable",
      "required": true,
      "notes": "Secondary Chromium stable baseline"
    },
    {
      "browser": "chrome",
      "channel": "canary",
      "required": true,
      "notes": "Early regression detection before stable release"
    }
  ],
  "metadata": {
    "source": "docs/ROADMAP.md#phase-11-project-configuration",
    "ciWorkflow": ".github/workflows/e2e.yml",
    "script": "scripts/browser-regression-gate.mjs"
  }
}
